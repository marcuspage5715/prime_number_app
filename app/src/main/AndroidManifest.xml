<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      This manifest declares NO permissions - not even INTERNET. The app computes
      prime numbers locally and has no reason to reach the network, so the
      strongest guarantee available is that it cannot: with no INTERNET
      permission the OS refuses any socket the app might try to open.

      Note for reviewers: after manifest merging, the built APK also contains one
      signature-level permission that AndroidX Core declares for its own internal
      receivers (<applicationId>.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION). It is
      granted automatically, is not shown to the user and grants no device access.
      Any *other* permission appearing in a merged manifest is a bug.
    -->

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrimeChecker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PrimeChecker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
